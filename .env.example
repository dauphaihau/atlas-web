# Base URL of the Laravel API (no trailing slash).
# Leave empty for same-origin (e.g. when using Vite proxy to the backend).
# Example for separate backend: http://localhost:8000
VITE_API_BASE_URL=

# Laravel Reverb (WebSockets) for real-time import progress. Match backend Reverb config.
# If unset, import progress falls back to polling the status API.
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
